# User and group IDs for file permissions inside containers.
# Run: id $USER
PUID=1001
PGID=1001

# Timezone for scheduling (Sonarr/Radarr release times).
# Brasília, Brazil (UTC-3)
TZ=America/Sao_Paulo

# Optional but recommended for first-time Plex server setup.
# Generate at https://www.plex.tv/claim (expires in ~4 minutes).
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx

# qBittorrent web UI port (default 8080 conflicts with many apps).
WEBUI_PORT=8082

# Common credentials for all web UIs (*Arr, qBittorrent, Jellyfin, Seerr).
COMMON_USER=admin
COMMON_PASSWORD=your-secure-password

# qBittorrent Web UI credentials.
QBITTORRENT_USER=${COMMON_USER}
QBITTORRENT_PASSWORD=${COMMON_PASSWORD}

# Default private Prowlarr indexer.
AMIGOS_SHARE_USERNAME=
AMIGOS_SHARE_PASSWORD=

# BitTorrent peer connection port (TCP + UDP).
QBITTORRENT_PEER_PORT=6881

# Jellyfin admin credentials (used by Seerr and automation scripts).
# On a fresh config, make configure uses these to complete Jellyfin's startup wizard.
JELLYFIN_ADMIN_USER=${COMMON_USER}
JELLYFIN_ADMIN_PASSWORD=${COMMON_PASSWORD}
JELLYFIN_ADMIN_EMAIL=${COMMON_USER}@local
JELLYFIN_SERVER_NAME="CLSS Jellyfin"
JELLYFIN_ENABLE_REMOTE_ACCESS=true
JELLYFIN_ENABLE_AUTOMATIC_PORT_MAPPING=false
# Interval in hours for Jellyfin's periodic media library scan task (1-168).
JELLYFIN_LIBRARY_SCAN_INTERVAL_HOURS=12

# Optional locale/metadata overrides for Jellyfin's startup wizard.
JELLYFIN_UI_CULTURE=pt-BR
JELLYFIN_METADATA_COUNTRY=BR
JELLYFIN_METADATA_LANGUAGE=pt-BR

# Seerr admin credentials (used after first setup).
SEERR_ADMIN_EMAIL=${COMMON_USER}@local
SEERR_ADMIN_PASSWORD=${COMMON_PASSWORD}

# Web UI ports for *Arr services (optional overrides).
SONARR_PORT=8989
RADARR_PORT=7878
PROWLARR_PORT=9696
BAZARR_PORT=6767
SEERR_PORT=5055

# Jellyfin media server (free remote streaming).
JELLYFIN_PORT=8096
JELLYFIN_DISCOVERY_PORT=7359
# Optional: public URL for remote clients (e.g. http://your-server-ip:8096).
JELLYFIN_PUBLISHED_SERVER_URL=

# Optional public URLs used by Seerr settings.
SEERR_PUBLIC_URL=
JELLYFIN_EXTERNAL_URL=
RADARR_EXTERNAL_URL=
SONARR_EXTERNAL_URL=

# End-to-end validation defaults. DRY_RUN=true never starts a real download.
E2E_DRY_RUN=true
E2E_MOVIE_TMDB_ID=550
E2E_MOVIE_TITLE=Fight Club
# Set true only when DRY_RUN=false and the selected content is legal, owned,
# public-domain, free, or explicitly authorized for this environment.
E2E_AUTHORIZED_CONTENT=false
